# کلید API رایگان OpenRouter برای بخش چت (از ایران هم معمولاً بدون فیلترشکن در دسترسه)
# از https://openrouter.ai/keys بگیر (ثبت‌نام رایگان، بدون نیاز به کارت اعتباری برای مدل‌های :free)
OPENROUTER_API_KEY=xxxxxxxx

# اختیاری: مدل مورد استفاده (پیش‌فرض: meta-llama/llama-3.3-70b-instruct:free)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
